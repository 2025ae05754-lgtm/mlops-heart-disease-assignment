{
    "title": "Cardiac Risk API",
    "schemaVersion": 39,
    "panels": [
        {
            "title": "Prediction Requests",
            "type": "timeseries",
            "targets": [
                {
                    "expr": "rate(prediction_requests_total[5m])"
                }
            ]
        },
        {
            "title": "Prediction Latency",
            "type": "timeseries",
            "targets": [
                {
                    "expr": "histogram_quantile(0.95, rate(prediction_latency_seconds_bucket[5m]))"
                }
            ]
        }
    ]
}